# Copy this file to .env and fill in your values for local development.
# On Render, set these in the Environment tab instead — do NOT commit .env to git.

# ── Email OTP (required for magic code login) ──────────────────────────────────
# Get a free key at https://resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The "from" address for OTP emails. Must be a verified domain on Resend.
# During development you can use: onboarding@resend.dev (Resend's test address)
RESEND_FROM=OB Journal <onboarding@resend.dev>

# ── Google Sign-In (optional) ─────────────────────────────────────────────────
# Get from https://console.cloud.google.com → APIs & Services → Credentials
# Create an OAuth 2.0 Client ID (Web application)
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# ── AI providers (optional — add whichever you use) ───────────────────────────
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Database (leave blank to use local SQLite) ────────────────────────────────
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyxxxxxxxx
